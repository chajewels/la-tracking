# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These are the Supabase PUBLISHABLE (anon) credentials. They are shipped in
# every browser bundle by design, so they are not secret — but they still do not
# belong in git, because a tracked .env is where a real secret eventually lands
# by accident. Anything with service-role rights belongs in Lovable secrets or
# GitHub Actions secrets, never in this file.
#
# CI does not read this file: .github/workflows/firebase-deploy.yml passes
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY from GitHub Actions
# secrets at build time.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase anon key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side duplicates used by local tooling.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase anon key>
